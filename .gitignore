# ─────────────────────────────────────────────
# .NET Build Output & Cache
# ─────────────────────────────────────────────
bin/
obj/
**/bin/
**/obj/
*.user
**/*.user
*.suo
**/*.suo
*.userosscache
*.sln.docstates

# ─────────────────────────────────────────────
# Secrets & Environment Files — NEVER commit secrets
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json

# Note:
# appsettings.json IS committed with safe placeholder credentials
# appsettings.example.json IS committed as a reference template

